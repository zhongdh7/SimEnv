<launch>
  <!-- Standalone hazard perception only: no navigation, SLAM/LIO package, planner or verifier. -->
  <arg name="pose_source" default="tf" doc="tf, odom, or orientation-only imu"/>

  <arg name="rgb_topic" default="/real_sense/rgb/image_raw"/>
  <arg name="depth_topic" default="/real_sense/depth/image_raw"/>
  <arg name="rgb_info_topic" default="/real_sense/rgb/camera_info"/>
  <arg name="depth_info_topic" default="/real_sense/depth/camera_info"/>
  <arg name="depth_points_topic" default="/real_sense/depth/points"/>
  <arg name="use_livox" default="false"/>
  <arg name="livox_topic" default="/scan"/>

  <arg name="output_directory" default="$(env HOME)/SimEnv/results/hazard_perception_v0"/>
  <arg name="run_id" default=""/>
  <arg name="start_frame" default="start_frame"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="base_frame" default="base"/>
  <arg name="publish_debug_images" default="true"/>
  <arg name="publish_candidates" default="true"/>

  <arg name="odom_topic" default="/Odometry"/>
  <arg name="output_odom_topic" default="/hazard_pose/odom"/>
  <arg name="publish_odom_tf" default="true"/>
  <arg name="imu_topic" default="/trunk_imu"/>
  <arg name="imu_reference_frame" default="hazard_imu_reference"/>
  <arg name="imu_orientation_frame" default="hazard_imu_orientation"/>

  <arg name="pipeline_odom_frame"
       default="$(eval {'tf': arg('odom_frame'), 'odom': arg('odom_frame'), 'imu': arg('imu_reference_frame')}[arg('pose_source')])"/>
  <arg name="pipeline_base_frame"
       default="$(eval {'tf': arg('base_frame'), 'odom': arg('base_frame'), 'imu': arg('imu_orientation_frame')}[arg('pose_source')])"/>

  <node if="$(eval arg('pose_source') == 'odom')"
        pkg="hazard_perception_v0" type="hazard_odom_tf_bridge.py"
        name="hazard_odom_tf_bridge" output="screen" required="true">
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="parent_frame" value="$(arg odom_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="publish_tf" value="$(arg publish_odom_tf)"/>
    <param name="output_odom_topic" value="$(arg output_odom_topic)"/>
  </node>

  <!-- Development mode only. It publishes relative attitude and zero/invalid translation. -->
  <node if="$(eval arg('pose_source') == 'imu')"
        pkg="hazard_perception_v0" type="hazard_imu_tf_bridge.py"
        name="hazard_imu_tf_bridge" output="screen" required="true">
    <param name="imu_topic" value="$(arg imu_topic)"/>
    <param name="reference_frame" value="$(arg imu_reference_frame)"/>
    <param name="orientation_frame" value="$(arg imu_orientation_frame)"/>
    <param name="status_topic" value="/hazard_pose/imu_status"/>
  </node>

  <include file="$(find hazard_perception_v0)/launch/hazard_pipeline.launch">
    <arg name="rgb_topic" value="$(arg rgb_topic)"/>
    <arg name="depth_topic" value="$(arg depth_topic)"/>
    <arg name="rgb_info_topic" value="$(arg rgb_info_topic)"/>
    <arg name="depth_info_topic" value="$(arg depth_info_topic)"/>
    <arg name="depth_points_topic" value="$(arg depth_points_topic)"/>
    <arg name="use_livox" value="$(arg use_livox)"/>
    <arg name="livox_topic" value="$(arg livox_topic)"/>
    <arg name="output_directory" value="$(arg output_directory)"/>
    <arg name="run_id" value="$(arg run_id)"/>
    <arg name="start_frame" value="$(arg start_frame)"/>
    <arg name="odom_frame" value="$(arg pipeline_odom_frame)"/>
    <arg name="base_frame" value="$(arg pipeline_base_frame)"/>
    <arg name="publish_debug_images" value="$(arg publish_debug_images)"/>
    <arg name="publish_candidates" value="$(arg publish_candidates)"/>
  </include>
</launch>
