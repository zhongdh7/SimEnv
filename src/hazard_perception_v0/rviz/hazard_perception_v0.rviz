Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Reference Frame: start_frame
    - Class: rviz/RobotModel
      Description Source: Topic
      Description Topic: /robot_description
      Enabled: true
      Name: RobotModel
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: true
      Tree:
        {}
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /hazard_perception/markers
      Name: Hazards
      Namespaces:
        candidate: true
        candidate_text: true
        confirmed: true
        confirmed_text: true
      Queue Size: 20
    - Class: rviz/Image
      Enabled: true
      Image Topic: /hazard_perception/pipeline_debug_image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Pipeline Debug Image
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: start_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Transformation:
    Current:
      Class: rviz/TF
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.55
      Target Frame: start_frame
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1440
  X: 80
  Y: 50
