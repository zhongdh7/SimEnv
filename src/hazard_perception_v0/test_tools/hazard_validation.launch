<launch>
  <arg name="config" default="$(find hazard_perception_v0)/test_tools/hazard_validation.yaml"/>
  <arg name="output_root" default="$(find hazard_perception_v0)/../../results/hazard_validation"/>
  <arg name="start_pipeline" default="true"/>

  <!-- This include exists only in the test launch. hazard_pipeline.launch does
       not include or know about the Gazebo evaluator. Livox is intentionally off. -->
  <include if="$(arg start_pipeline)"
           file="$(find hazard_perception_v0)/launch/hazard_pipeline.launch">
    <arg name="use_livox" value="false"/>
    <arg name="publish_debug_images" value="true"/>
    <arg name="publish_candidates" value="true"/>
    <arg name="save_csv" value="false"/>
    <arg name="rviz" value="false"/>
  </include>

  <node pkg="hazard_perception_v0"
        type="hazard_validation.py"
        name="hazard_gazebo_validation"
        output="screen"
        required="true">
    <rosparam command="load" file="$(arg config)"/>
    <param name="output_root" value="$(arg output_root)"/>
  </node>
</launch>
