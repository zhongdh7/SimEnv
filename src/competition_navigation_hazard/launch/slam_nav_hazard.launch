<launch>
<!-- 整合启动：FAST-LIO2 SLAM + C++ 导航 + 危险源监测（浅整合，互不改动）。

     在导航探索的同时运行 hazard_pipeline 检测红球危险源。导航逻辑
     (competition_navigation_fastlio2_cpp) 与危险源检测 (hazard_perception)
     各自独立运行，本 launch 只是把它们一起拉起，用于验证探索过程中
     能否同时检测到危险源。

     Usage (after SimEnv + junior_ctrl 运行，且 ws_livox 已 source):
       source /opt/ros/noetic/setup.bash
       source $SIMENV/devel/setup.bash
       source $WSLIVOX/devel/setup.bash
       roslaunch competition_navigation_hazard slam_nav_hazard.launch
-->

  <arg name="rviz" default="false" />
  <arg name="auto_start" default="true" />
  <!-- full_map_verifier lived in the archived competition_navigation_fastlio2
       package.  Keep the optional flag for legacy users, but do not let the
       clean self-contained default chain depend on an archived package. -->
  <arg name="start_verifier" default="false" />
  <!-- Low small-obstacle RGB-D avoidance.  off by default so a plain hazard
       run keeps identical behaviour; set true to feed low_obstacle_node into
       collision_safety. -->
  <arg name="enable_low_obstacle" default="true" />
  <arg name="low_obstacle_topic" default="/hazard_perception/low_obstacles" />
  <arg name="use_livox" default="false" />
  <arg name="output_directory" default="$(env SIMENV)/results/hazard" />
  <arg name="model_path" default="$(env HDPLANNER_ROOT)/model/HDPlanner_Nav/policy_traced.pt" />
  <arg name="library_path" default="$(env SIMENV)/devel/lib/libhdplanner_inference.so" />
  <arg name="layout_metadata_path" default="$(env SIMENV)/generated_building/layout_metadata.json" />
  <arg name="coverage_report_path" default="$(env SIMENV)/results/full_map_coverage.json" />
  <arg name="corridor_max_linear" default="1.00" />
  <arg name="room_max_linear" default="0.60" />
  <arg name="turn_linear_scale" default="0.20" />
  <arg name="scan_yaw_rate" default="0.80" />
  <arg name="stair_speed" default="1.00" />

  <!-- 1. FAST-LIO2 SLAM + C++ 导航 + save_pcd -->
  <include file="$(find competition_navigation_fastlio2_cpp)/launch/slam_nav.launch">
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="auto_start" value="$(arg auto_start)" />
    <arg name="start_verifier" value="$(arg start_verifier)" />
    <arg name="model_path" value="$(arg model_path)" />
    <arg name="library_path" value="$(arg library_path)" />
    <arg name="layout_metadata_path" value="$(arg layout_metadata_path)" />
    <arg name="coverage_report_path" value="$(arg coverage_report_path)" />
    <arg name="obstacle_topic" value="$(arg low_obstacle_topic)" />
    <arg name="corridor_max_linear" value="$(arg corridor_max_linear)" />
    <arg name="room_max_linear" value="$(arg room_max_linear)" />
    <arg name="turn_linear_scale" value="$(arg turn_linear_scale)" />
    <arg name="scan_yaw_rate" value="$(arg scan_yaw_rate)" />
    <arg name="stair_speed" value="$(arg stair_speed)" />
  </include>

  <!-- 2. 危险源监测（红球 RGB-D 检测 + 定位跟踪 + 结果管理）-->
  <include file="$(find hazard_perception)/launch/hazard_pipeline.launch">
    <arg name="use_livox" value="$(arg use_livox)" />
    <arg name="output_directory" value="$(arg output_directory)" />
    <arg name="rviz" value="false" />
  </include>

  <!-- 2b. 低矮小型障碍物 RGB-D 检出 → 接入 collision_safety 避障。
       与红球危险源报告管线完全独立：不改变 hazard 识别/最终化，
       只发布 odom 系小物云供 C++ 避障层消费。 -->
  <node if="$(arg enable_low_obstacle)"
        pkg="hazard_perception"
        type="low_obstacle_node.py"
        name="low_obstacle_node"
        output="screen">
    <param name="out_topic" value="$(arg low_obstacle_topic)" />
  </node>

  <!-- 3. 探索完成自动保存危险源结果：监听导航状态，检测到三层全图完成
       (full_map_complete / returned_home) 后调用 /hazard_perception/finalize，
       把检测到的危险源坐标写入 output_directory。 -->
  <node pkg="competition_navigation_hazard"
        type="hazard_finalize_trigger.py"
        name="hazard_finalize_trigger"
        output="screen" />
</launch>
