<launch>
  <!-- ============================================================ -->
  <!-- DWA Navigation: GlobalPlanner + DWAPlannerROS + AMCL         -->
  <!-- ============================================================ -->

  <!-- Arguments -->
  <arg name="map_file" default="$(find dwa_navigation)/maps/new_map.yaml"/>
  <arg name="open_rviz" default="true"/>

  <!-- 1. Map Server - loads static map -->
  <node pkg="map_server" type="map_server" name="map_server"
        args="$(arg map_file)">
    <param name="frame_id" value="map"/>
  </node>

  <!-- 2. PointCloud to LaserScan converter -->
  <!--     /scan (PointCloud, laser_livox) -> /scan_laser (LaserScan, laser_livox) -->
  <node pkg="dwa_navigation" type="pointcloud_to_laserscan.py"
        name="pointcloud_to_laserscan" output="screen">
    <!-- Sensor geometry: laser_livox -> base transform -->
    <param name="laser_x" value="0.2"/>
    <param name="laser_z" value="0.08"/>
    <param name="laser_pitch" value="0.785"/>
    <!-- Ground filter: obstacle = bz > ground_z + ground_margin                     -->
    <!--   threshold = -0.31 + 0.12 = -0.19 (base frame)                             -->
    <!--   0.15m sphere center bz≈-0.16 > -0.19 → DETECTED (was missed at -0.06)     -->
    <param name="ground_z" value="-0.31"/>
    <param name="ground_margin" value="0.2"/>
    <param name="ground_margin_tilted" value="0.40"/>
    <!-- ceiling_z: filter points above robot reach (base=0, robot top ~0.40) -->
    <param name="ceiling_z" value="0.50"/>
    <!-- max_v_angle: drop rays with vertical angle > 40 deg (was 25 deg) -->
    <param name="max_v_angle" value="0.70"/>
    <!-- Tilt protection: when tilt > 5.7° -->
    <!--   1. Forward blind cone (proportional: 0°→±60°) — drop ground returns  -->
    <!--   2. All rays switch to ground_margin_tilted (0.40) — stair-tolerant   -->
    <param name="max_tilt" value="0.10"/>
    <param name="blind_cone_half" value="1.047"/>
    <param name="blind_cone_ramp" value="0.175"/>
    <!-- Scan parameters -->
    <param name="angle_min" value="-3.14159"/>
    <param name="angle_max" value="3.14159"/>
    <param name="angle_increment" value="0.01745"/>
    <param name="range_min" value="0.15"/>
    <param name="range_max" value="30.0"/>
    <param name="input_topic" value="/scan"/>
    <param name="output_topic" value="/scan_laser"/>
  </node>

  <!-- 3. AMCL - Adaptive Monte Carlo Localization (enhanced) -->
  <!--     Subscribes to /scan_laser (remapped from default "scan") -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <remap from="scan" to="/scan_laser"/>

    <!-- ============================================================ -->
    <!-- Odometry model — anti-rotation-drift: spread during turns     -->
    <!--   alpha1=0.4: moderate yaw noise → covers foot-slip rotation   -->
    <!--   alpha4=0.4: moderate slip → covers lateral drift in turns    -->
    <!--   alpha3=0.15: low XY noise → trust straight-line odometry     -->
    <!-- ============================================================ -->
    <param name="odom_model_type" value="diff"/>
    <param name="odom_alpha1" value="0.4"/>
    <param name="odom_alpha2" value="0.2"/>
    <param name="odom_alpha3" value="0.15"/>
    <param name="odom_alpha4" value="0.4"/>
    <param name="odom_alpha5" value="0.15"/>

    <!-- ============================================================ -->
    <!-- Laser model — strong correction after rotation                -->
    <!--   z_hit=0.92, z_rand=0.02: laser-driven with some tolerance    -->
    <!--   sigma_hit=0.10: sharp enough to pull particles after turn    -->
    <!-- ============================================================ -->
    <param name="laser_model_type" value="likelihood_field"/>
    <param name="laser_likelihood_max_dist" value="2.0"/>
    <param name="laser_z_hit" value="0.92"/>
    <param name="laser_z_short" value="0.03"/>
    <param name="laser_z_max" value="0.03"/>
    <param name="laser_z_rand" value="0.02"/>
    <param name="laser_sigma_hit" value="0.10"/>
    <param name="laser_lambda_short" value="0.1"/>

    <!-- ============================================================ -->
    <!-- Particle filter — anti-rotation: dense cloud, frequent update -->
    <!--   min=3000, max=15000: more particles during turn uncertainty  -->
    <!--   update_min_a=0.05: every ~2.9° → frequent correction in turn -->
    <!--   selective_resampling=false: always resample → faster recovery -->
    <!-- ============================================================ -->
    <param name="min_particles" value="3000"/>
    <param name="max_particles" value="15000"/>
    <param name="kld_err" value="0.01"/>
    <param name="kld_z" value="0.99"/>
    <param name="resample_interval" value="1"/>
    <param name="selective_resampling" value="false"/>
    <param name="update_min_d" value="0.15"/>
    <param name="update_min_a" value="0.05"/>

    <!-- ============================================================ -->
    <!-- Recovery — moderate injection to re-anchor after rotation      -->
    <!-- ============================================================ -->
    <param name="recovery_alpha_slow" value="0.005"/>
    <param name="recovery_alpha_fast" value="0.05"/>

    <!-- ============================================================ -->
    <!-- Frame configuration — tight TF sync for scan matching          -->
    <!-- ============================================================ -->
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base"/>
    <param name="global_frame_id" value="map"/>
    <param name="transform_tolerance" value="0.2"/>

    <!-- ============================================================ -->
    <!-- Laser settings: use all 360 beams for dense sampling         -->
    <!-- ============================================================ -->
    <param name="scan_topic" value="/scan_laser"/>
    <param name="laser_max_beams" value="360"/>
    <param name="gui_publish_rate" value="10.0"/>

    <!-- ============================================================ -->
    <!-- Initial pose: match SimEnv auto.sh defaults                    -->
    <!--   Covariance allows ~0.5m xy, ~18° yaw initial uncertainty    -->
    <!-- ============================================================ -->
    <param name="initial_pose_x" value="0.0"/>
    <param name="initial_pose_y" value="-3.2"/>
    <param name="initial_pose_a" value="1.5708"/>
    <param name="initial_cov_xx" value="0.25"/>
    <param name="initial_cov_yy" value="0.25"/>
    <param name="initial_cov_aa" value="0.1"/>
  </node>

  <!-- 4. Move Base - Navigation Stack -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <!-- Load costmap parameters -->
    <!-- Shared params at costmap level (inflation_layer reads from here) -->
    <rosparam file="$(find dwa_navigation)/config/costmap_common_params.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find dwa_navigation)/config/costmap_common_params.yaml"
              command="load" ns="local_costmap"/>
    <!-- Explicitly load into obstacle_layer namespaces so sensors are found -->
    <rosparam file="$(find dwa_navigation)/config/costmap_common_params.yaml"
              command="load" ns="global_costmap/obstacle_layer"/>
    <rosparam file="$(find dwa_navigation)/config/costmap_common_params.yaml"
              command="load" ns="local_costmap/obstacle_layer"/>
    <rosparam file="$(find dwa_navigation)/config/global_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find dwa_navigation)/config/local_costmap_params.yaml"
              command="load"/>

    <!-- Planners -->
    <param name="base_global_planner" value="global_planner/GlobalPlanner"/>
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS"/>

    <!-- Load planner parameters -->
    <rosparam file="$(find dwa_navigation)/config/global_planner_params.yaml"
              command="load"/>
    <rosparam file="$(find dwa_navigation)/config/dwa_local_planner_params.yaml"
              command="load"/>

    <!-- Recovery behaviors (only 1 rotate — less AMCL drift) -->
    <rosparam param="recovery_behaviors">
      - {name: conservative_reset, type: clear_costmap_recovery/ClearCostmapRecovery}
      - {name: aggressive_reset, type: clear_costmap_recovery/ClearCostmapRecovery}
    </rosparam>

    <param name="conservative_reset/reset_distance" value="0.0"/>
    <param name="aggressive_reset/reset_distance" value="0.0"/>

    <!-- Control loop frequency — high-speed (4 m/s) requires fast replanning    -->
    <!--   planner_freq=3.0 Hz → new global plan every 1.33 m (was 0.5 Hz→8m) -->
    <!--   controller_freq=30 Hz → smoother vel commands at high speed          -->
    <param name="controller_frequency" value="30.0"/>
    <param name="controller_patience" value="3.0"/>
    <param name="planner_frequency" value="3.0"/>
    <param name="planner_patience" value="5.0"/>

    <!-- Make plan available for RViz -->
    <param name="make_plan_clear_obstacles" value="true"/>
    <param name="make_plan_add_unreachable_goal" value="true"/>
  </node>

  <!-- 5. RViz -->
  <node if="$(arg open_rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find dwa_navigation)/rviz/dwa_nav.rviz"/>

</launch>
