<launch>
  <!-- Cartographer SLAM launch for Unitree A1 with Livox Mid-360
       Uses /livox/Pointcloud2 (PointCloud2) and /livox/imu (Imu)
       Must be launched after the Gazebo simulation is running.
  -->

  <arg name="use_sim_time" default="true"/>
  <arg name="configuration_directory" default="$(find slam_module)/config"/>
  <arg name="configuration_basename" default="a1_livox_2d.lua"/>
  <arg name="resolution" default="0.05"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <!-- Cartographer node -->
  <node name="cartographer_node" pkg="cartographer_ros"
      type="cartographer_node" args="
          -configuration_directory $(arg configuration_directory)
          -configuration_basename $(arg configuration_basename)"
      output="screen">
    <remap from="points2" to="/livox/Pointcloud2"/>
    <remap from="imu" to="/livox/imu"/>
  </node>

  <!-- Occupancy grid node: converts submaps to occupancy grid for navigation -->
  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
      type="cartographer_occupancy_grid_node" args="-resolution $(arg resolution)"/>

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find slam_module)/config/slam.rviz"/>
  <node name="rqt_robot_steering" pkg="rqt_robot_steering" type="rqt_robot_steering"/>

</launch>
