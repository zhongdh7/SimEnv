<launch>
  <!-- GMapping SLAM launch for Unitree A1 with Livox Mid-360
       Converts /livox/Pointcloud2 to LaserScan, then runs gmapping.

       Prerequisites: Gazebo simulation must be running with Livox enabled.
       Usage:
         source /opt/ros/noetic/setup.bash
         source ~/SimEnv/devel/setup.bash
         roslaunch slam_module gmapping_slam.launch
  -->

  <arg name="use_sim_time" default="true"/>
  <arg name="scan_topic" default="/scan_converted"/>
  <arg name="resolution" default="0.05"/>

  <param name="use_sim_time" value="$(arg use_sim_time)"/>

  <!-- ===== Step 1: Convert PointCloud2 to LaserScan ===== -->
  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node"
      name="pointcloud_to_laserscan" output="screen">
    <remap from="cloud_in" to="/livox/Pointcloud2"/>
    <remap from="scan" to="$(arg scan_topic)"/>
    <rosparam>
      target_frame: base
      transform_tolerance: 1.0
      min_height: -0.05
      max_height: 1.0   
      angle_min: -3.14159
      angle_max: 3.14159
      angle_increment: 0.0175
      scan_time: 0.1
      range_min: 0.5
      range_max: 15.0
      use_inf: false
      inf_epsilon: 1.0
      concurrency_level: 1
    </rosparam>
  </node>

  <!-- ===== Step 2: GMapping SLAM node ===== -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <remap from="scan" to="$(arg scan_topic)"/>
    <param name="base_frame" value="base"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame" value="map"/>
    <param name="map_update_interval" value="2.0"/>
    <param name="maxUrange" value="15.0"/>
    <param name="maxRange" value="15.0"/>
    <param name="sigma" value="0.05"/>
    <param name="kernelSize" value="1"/>
    <param name="lstep" value="0.05"/>
    <param name="astep" value="0.05"/>
    <param name="iterations" value="5"/>
    <param name="lsigma" value="0.075"/>
    <param name="ogain" value="3.0"/>
    <param name="lskip" value="0"/>
    <param name="minimumScore" value="0.0"/>
    <param name="srr" value="0.1"/>
    <param name="srt" value="0.2"/>
    <param name="str" value="0.1"/>
    <param name="stt" value="0.2"/>
    <param name="linearUpdate" value="0.3"/>
    <param name="angularUpdate" value="0.3"/>
    <param name="temporalUpdate" value="0.5"/>
    <param name="resampleThreshold" value="0.5"/>
    <param name="particles" value="30"/>
    <param name="xmin" value="-20.0"/>
    <param name="ymin" value="-20.0"/>
    <param name="xmax" value="20.0"/>
    <param name="ymax" value="20.0"/>
    <param name="delta" value="$(arg resolution)"/>
    <param name="llsamplerange" value="0.01"/>
    <param name="llsamplestep" value="0.01"/>
    <param name="lasamplerange" value="0.005"/>
    <param name="lasamplestep" value="0.005"/>
  </node>
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find slam_module)/config/slam.rviz"/>
  <node name="rqt_robot_steering" pkg="rqt_robot_steering" type="rqt_robot_steering"/>
  <node name="map_server" pkg="map_server" type="map_server" args="$(find slam_module)/config/gamappings_slam.yaml"/>

</launch>
