<?xml version="1.0"?>
<package format="2">
  <name>competition_navigation_hazard_v0</name>
  <version>0.1.0</version>
  <description>Integrated launch: run FAST-LIO2 SLAM + C++ navigation and hazard-perception-v0 side-by-side during exploration.</description>
  <maintainer email="ros@todo.todo">SimEnv navigation</maintainer>
  <license>UNLICENSED</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>competition_navigation_fastlio2_cpp</exec_depend>
  <exec_depend>hazard_perception_v0</exec_depend>
  <exec_depend>fastlio2_merge</exec_depend>
</package>
