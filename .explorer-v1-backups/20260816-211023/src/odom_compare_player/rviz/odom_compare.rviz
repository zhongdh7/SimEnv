Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Grid1
        - /Odom Compare Markers1
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: map
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Name: Odom Compare Markers
      Namespaces:
        {}
      Queue Size: 100
      Marker Topic: /odom_compare_markers
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Name: Animated Trails
      Namespaces:
        {}
      Queue Size: 100
      Marker Topic: /gt_path_anim
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Name: Animated LIO Trail
      Namespaces:
        {}
      Queue Size: 100
      Marker Topic: /lio_path_anim
      Value: true
    - Class: rviz/Pose
      Enabled: true
      Name: GT Pose
      Topic: /gt_pose
      Shape: Axes
      Axes Length: 1.0
      Axes Radius: 0.1
      Color: 0; 255; 0
      Value: true
    - Class: rviz/Pose
      Enabled: true
      Name: LIO Pose
      Topic: /lio_pose
      Shape: Axes
      Axes Length: 1.0
      Axes Radius: 0.1
      Color: 255; 0; 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
    - Class: rviz/SetGoal
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 30
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.79
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.79
    Saved: ~
