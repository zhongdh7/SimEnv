<launch>
  <!-- Loop-closure-corrected 2-D localisation with Cartographer.
       Produces TF ``carto_map -> base`` (drift-free) and an occupancy grid
       /carto_map_grid for verification.  Independent of the navigation stack.

       Requires the sim (Gazebo + robot_state_publisher + state_from_gazebo) to
       already be running so that /scan and the base -> laser_livox static TF
       exist.  cartographer_ros must be sourced from ~/cartographer_ws. -->
  <arg name="use_sim_time" default="true" />
  <arg name="scan_topic" default="/scan" />
  <arg name="laser_topic" default="/scan_2d" />
  <arg name="target_frame" default="base" />
  <arg name="source_frame" default="laser_livox" />
  <arg name="resolution" default="0.05" />
  <arg name="publish_period_sec" default="1.0" />
  <arg name="odom_src_topic" default="/Odometry_gazebo" />
  <arg name="odom_topic" default="/odom_dedup" />
  <!-- Optional odometry frame relabelling.  For FAST-LIO2 (which publishes
       /Odometry in frame "camera_init" with child "body", where body == base),
       pass odom_frame:=camera_init odom_child_frame:=base so Cartographer's
       SensorBridge accepts the odometry (it TF-looks-up tracking_frame <-
       child_frame_id, and "body" is not in the robot's TF tree). -->
  <arg name="odom_frame" default="" />
  <arg name="odom_child_frame" default="" />
  <arg name="rviz" default="false" />

  <param name="/use_sim_time" value="$(arg use_sim_time)" />

  <!-- 1. Legacy 3-D /scan (PointCloud) -> 2-D /scan_2d (LaserScan, base). -->
  <node pkg="carto_localization" type="pointcloud_to_laserscan.py"
        name="pointcloud_to_laserscan" output="screen">
    <param name="scan_topic" value="$(arg scan_topic)" />
    <param name="laser_topic" value="$(arg laser_topic)" />
    <param name="target_frame" value="$(arg target_frame)" />
    <param name="source_frame" value="$(arg source_frame)" />
  </node>

  <!-- 1b. Dedup the odometry stream so Cartographer never sees a duplicate or
       out-of-order timestamp (which crashes map_by_time.h). -->
  <node pkg="carto_localization" type="odom_dedup.py" name="odom_dedup"
        output="screen">
    <param name="in_topic" value="$(arg odom_src_topic)" />
    <param name="out_topic" value="$(arg odom_topic)" />
    <param name="frame_id" value="$(arg odom_frame)" />
    <param name="child_frame" value="$(arg odom_child_frame)" />
  </node>

  <!-- 2. Cartographer 2-D SLAM with loop closure. -->
  <node name="cartographer_node" pkg="cartographer_ros"
        type="cartographer_node"
        args="
          -configuration_directory $(find carto_localization)/config
          -configuration_basename carto_2d.lua"
        output="screen">
    <remap from="scan" to="$(arg laser_topic)" />
    <remap from="odom" to="$(arg odom_topic)" />
  </node>

  <!-- 3. Publish the 2-D occupancy grid (for RViz / verification). -->
  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
        type="cartographer_occupancy_grid_node"
        args="-resolution $(arg resolution)
              -publish_period_sec $(arg publish_period_sec)"
        output="screen">
    <remap from="map" to="/carto_map_grid" />
  </node>

  <!-- 4. Optional RViz. -->
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find carto_localization)/rviz/carto.rviz" />
</launch>
